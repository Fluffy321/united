# Supabase Edge Function secret only. Never expose this as a VITE_ variable.
# Request a key at https://511ny.org/developers/doc, then run:
# supabase secrets set NY511_API_KEY='<key>'
NY511_API_KEY=

# Supabase Edge Function secret only. Used by authenticated directory photo
# lookups and the admin business importer. Never expose this as a VITE_ variable.
# Enable Places API (New), restrict the key to that API, then run:
# supabase secrets set GOOGLE_PLACES_API_KEY='<key>'
GOOGLE_PLACES_API_KEY=
