{
  "name": "ModerationAuditLog",
  "type": "object",
  "properties": {
    "admin_id": {
      "type": "string"
    },
    "admin_name": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "dismiss",
        "remove_content",
        "warn_user",
        "temp_ban",
        "perm_ban",
        "shadow_ban",
        "community_ban",
        "approve_claim",
        "reject_claim"
      ]
    },
    "report_id": {
      "type": "string"
    },
    "content_type": {
      "type": "string"
    },
    "content_id": {
      "type": "string"
    },
    "target_user_id": {
      "type": "string"
    },
    "target_user_name": {
      "type": "string"
    },
    "community_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "performed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "admin_id",
    "action"
  ]
}