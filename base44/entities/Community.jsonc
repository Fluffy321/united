{
  "name": "Community",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Shul",
        "School",
        "Yeshiva",
        "Seminary",
        "Camp",
        "Other"
      ]
    },
    "neighborhood": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "hours": {
      "type": "string"
    },
    "email_public": {
      "type": "string"
    },
    "rabbi_or_principal": {
      "type": "string"
    },
    "description_short": {
      "type": "string"
    },
    "description_long": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "logo_source": {
      "type": "string",
      "enum": [
        "NONE",
        "AUTO",
        "UPLOADED"
      ],
      "default": "NONE"
    },
    "cover_image_url": {
      "type": "string"
    },
    "is_claimed": {
      "type": "boolean",
      "default": false
    },
    "claimed_org_id": {
      "type": "string"
    },
    "follower_count": {
      "type": "number",
      "default": 0
    },
    "post_count": {
      "type": "number",
      "default": 0
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "isMainFeatured": {
      "type": "boolean",
      "default": false,
      "description": "Hero/main featured slot"
    },
    "featuredRank": {
      "type": "number",
      "description": "Sort order for featured communities"
    },
    "featured_slot_type": {
      "type": "string",
      "enum": [
        "hero",
        "secondary"
      ],
      "description": "Hero (main) or secondary slot if featured"
    },
    "featured_until": {
      "type": "string",
      "format": "date-time",
      "description": "When featured status expires"
    },
    "featured_tagline": {
      "type": "string",
      "description": "Short tagline for featured cards"
    },
    "featured_accent_color": {
      "type": "string",
      "description": "Hex color for featured card accent"
    },
    "featured_priority": {
      "type": "number",
      "default": 0,
      "description": "Higher = shown first"
    },
    "is_eligible_for_featured": {
      "type": "boolean",
      "default": false,
      "description": "Has community met eligibility requirements?"
    },
    "eligibility_checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time eligibility was verified"
    },
    "views_count": {
      "type": "number",
      "default": 0
    },
    "joins_this_week": {
      "type": "number",
      "default": 0
    },
    "posts_this_week": {
      "type": "number",
      "default": 0
    },
    "comments_this_week": {
      "type": "number",
      "default": 0
    },
    "is_seeded": {
      "type": "boolean",
      "default": false
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "Verified communities get admin controls and membership fees"
    },
    "verified_type": {
      "type": "string",
      "enum": [
        "Shul",
        "School",
        "Yeshiva",
        "Seminary",
        "Camp",
        "Organization"
      ],
      "description": "Type label in verified badge"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "type"
  ]
}