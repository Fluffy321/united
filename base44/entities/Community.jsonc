{
  "name": "Community",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Shul",
        "School",
        "Yeshiva",
        "Seminary",
        "Camp",
        "Other"
      ]
    },
    "category": {
      "type": "string"
    },
    "neighborhood": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "hours": {
      "type": "string"
    },
    "email_public": {
      "type": "string"
    },
    "rabbi_or_principal": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "description_short": {
      "type": "string"
    },
    "description_long": {
      "type": "string"
    },
    "rules": {
      "type": "string"
    },
    "who_its_for": {
      "type": "string"
    },
    "privacy": {
      "type": "string",
      "enum": [
        "public",
        "approval"
      ],
      "default": "public"
    },
    "logo_url": {
      "type": "string"
    },
    "logo_source": {
      "type": "string",
      "enum": [
        "NONE",
        "AUTO",
        "UPLOADED"
      ],
      "default": "NONE"
    },
    "cover_image_url": {
      "type": "string"
    },
    "is_claimed": {
      "type": "boolean",
      "default": false
    },
    "claimed_org_id": {
      "type": "string"
    },
    "follower_count": {
      "type": "number",
      "default": 0
    },
    "post_count": {
      "type": "number",
      "default": 0
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "isMainFeatured": {
      "type": "boolean",
      "default": false
    },
    "featuredRank": {
      "type": "number"
    },
    "featured_slot_type": {
      "type": "string",
      "enum": [
        "hero",
        "secondary"
      ]
    },
    "featured_until": {
      "type": "string",
      "format": "date-time"
    },
    "featured_tagline": {
      "type": "string"
    },
    "featured_accent_color": {
      "type": "string"
    },
    "featured_priority": {
      "type": "number",
      "default": 0
    },
    "is_eligible_for_featured": {
      "type": "boolean",
      "default": false
    },
    "eligibility_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "views_count": {
      "type": "number",
      "default": 0
    },
    "joins_this_week": {
      "type": "number",
      "default": 0
    },
    "posts_this_week": {
      "type": "number",
      "default": 0
    },
    "comments_this_week": {
      "type": "number",
      "default": 0
    },
    "is_seeded": {
      "type": "boolean",
      "default": false
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "verified_type": {
      "type": "string",
      "enum": [
        "Shul",
        "School",
        "Yeshiva",
        "Seminary",
        "Camp",
        "Organization"
      ]
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "verified_plan": {
      "type": "string",
      "enum": [
        "none",
        "small",
        "medium",
        "large"
      ],
      "default": "none",
      "description": "Paid Verified Community plan tier"
    },
    "verified_plan_billing": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "description": "Billing cycle for verified plan"
    },
    "verified_plan_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When current plan period expires"
    },
    "verified_plan_order_id": {
      "type": "string",
      "description": "Last checkout session / order ID for this plan"
    },
    "verified_accent_color": {
      "type": "string",
      "description": "Custom accent color for verified communities (hex)"
    },
    "donation_url": {
      "type": "string",
      "description": "External donate link (Stripe, PayPal, Chesed Fund, etc.)"
    }
  },
  "required": [
    "name"
  ]
}