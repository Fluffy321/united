{
  "name": "CommunityEventRSVP",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "community_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "going",
        "maybe",
        "not_attending"
      ],
      "default": "going"
    },
    "ticket_purchased": {
      "type": "boolean",
      "default": false,
      "description": "Whether user has completed ticket purchase"
    },
    "ticket_quantity": {
      "type": "number",
      "default": 1,
      "description": "Number of tickets purchased"
    },
    "order_id": {
      "type": "string",
      "description": "Payment order/session ID"
    }
  },
  "required": [
    "event_id",
    "user_id",
    "status"
  ]
}