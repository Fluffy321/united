{
  "name": "Notify on Community Announcement",
  "description": "When a new announcement is posted in a community, notify all members of that community.",
  "trigger": {
    "condition": "${ (.trigger.data.type == \"announcement\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "CommunityPost"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_on_community_announcement",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyOnAnnouncement",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyOnAnnouncement"
  }
}