# ──────────────────────────────────────────────────────────────
# JUnited — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ──────────────────────────────────────────────────────────────

# ── Supabase connection (required) ────────────────────────────
VITE_SUPABASE_ENABLED=false
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ── OAuth / magic-link redirect URL ──────────────────────────
# ⚠️  This MUST point to your production domain in production builds.
#     A localhost value here will cause OAuth to redirect to a dead address
#     for real users and will be caught at runtime with a console error.
#
# Development (.env.local):
#   VITE_AUTH_REDIRECT_URL=http://localhost:5173/login
#
# Production (.env.production or hosting provider env vars):
#   VITE_AUTH_REDIRECT_URL=https://your-production-domain.com/login
#
VITE_AUTH_REDIRECT_URL=http://localhost:5173/login

# ── Error tracking — Sentry (strongly recommended for beta) ───
# Create a project at https://sentry.io and copy the DSN.
# Leave empty to disable Sentry (errors will only appear in the console).
VITE_SENTRY_DSN=

# ── Product analytics — PostHog (recommended for beta) ────────
# Create a project at https://posthog.com and copy the key + host.
# Leave empty to disable PostHog.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# ── App metadata ──────────────────────────────────────────────
# Used for meta tags, sharing, and auth redirect fallbacks.
VITE_APP_URL=http://localhost:5173
