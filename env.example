# No external app-platform settings are required right now.
#
# Later, when we add a real backend, we can put new settings here.
# Example:
# VITE_API_URL=http://localhost:4000

# Supabase migration settings:
VITE_SUPABASE_ENABLED=false
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
VITE_AUTH_REDIRECT_URL=http://localhost:5173/login
